# Copy this file to .env in the project root (same folder as package.json)
# and fill in your real key. Never commit .env to version control.
#
# Get a free Groq API key (no credit card required) at:
# https://console.groq.com/keys

GROQ_API_KEY=your_groq_api_key_here

# Hugging Face token for image generation (recommended).
HF_API_KEY=your_huggingface_token_here
HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Google AI Studio key for image generation (fallback).
GEMINI_API_KEY=your_gemini_api_key_here
# Optional image model override:
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
